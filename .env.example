# Without these, AgentBridge visibly runs in deterministic demo mode.
NEBIUS_API_KEY=
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1
# Optional persistent SQLite path. Use a persistent disk for deployment.
AGENTBRIDGE_DB_PATH=./data/agentbridge.sqlite
# Local-only run defaults to an in-memory session secret; set a 32+ character value for deployment.
SESSION_SECRET=
